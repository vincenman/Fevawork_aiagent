    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "summaries",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [720, 336],
      "id": "e212173d-20cd-4ec6-985b-c7147c33bf89",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "// Get the first incoming item (usually from Aggregate node)\nconst items = $input.all();\n\nif (items.length === 0 || !items[0].json.summaries) {\n  return [];\n}\n\nconst summaries = items[0].json.summaries;\n\n// Build the lines array\nconst lines = [];\n\nsummaries.forEach((item, index) => {\n  // Prefer original filename from Google Drive download, then fallback\n  const filename = item.name || item.fileName || item.basename || `Resume_${index + 1}`;\n  \n  lines.push(`=== ${filename} ===\\n`);\n  lines.push((item.output || '').trim());\n  lines.push('\\n\\n');\n});\n\n// Create header with current date/time\nconst now = new Date();\nconst formattedDate = now.toLocaleString('en-US', {\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: false\n}).replace(/,/, '');\n\nconst header = \n  `RESUME BATCH SUMMARY - Processed on ${formattedDate}\\n` +\n  `Total resumes processed: ${summaries.length}\\n` +\n  '='.repeat(50) + '\\n\\n';\n\nconst combinedText = header + lines.join('');\n\nreturn [{\n  json: {\n    combinedSummary: combinedText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 336],
      "id": "bc019689-4bf6-4276-a952-8438b35b3287",
      "name": "Code in JS"
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "combinedSummary",
        "options": {
          "fileName": "resume_batch_summary.txt"
        }
      },
